---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import categories from '../../data/categories.json';
---
<Layout title="Danh mục decal thiết kế sẵn | CatDecal.vn" description="Khám phá các danh mục decal dán kính, trang trí, decal xe và ký hiệu; nhiều mẫu để lựa chọn." active="products">
  <header class="page-hero">
    <div class="wrap">
      <nav class="crumb" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><span>Sản phẩm mẫu</span></nav>
      <span class="eyebrow">Bộ sưu tập decal</span>
      <h1>Chọn danh mục, khám phá nhiều mẫu decal</h1>
      <p class="lead">Các mẫu thiết kế sẵn được chia theo mục đích sử dụng. Mở một danh mục để xem các mẫu và chọn màu, kích thước phù hợp. Cần làm nội dung riêng? <a href="/dich-vu/" style="font-weight: 800; text-decoration-color: var(--yellow-deep)">Xem dịch vụ cắt theo yêu cầu</a>.</p>
    </div>
  </header>
  <section class="section--tight" style="padding: 48px 0 96px">
    <div class="wrap">
      <div class="grid grid--catalog product-catalog-grid">
        {categories.map((c) => (
          <a class="card card--link c-card" href={'/san-pham/danh-muc/' + c.slug + '/'}>
            <div class="media"><span class="pill pill--yellow">{c.count} mẫu tham khảo</span><Scene scene={c.scene} ink={c.ink} label={c.sample} /></div>
            <div class="c-body">
              <h2 class="h3" style="font-size: 20px">{c.name}</h2>
              <p class="c-desc">{c.desc}</p>
              <div class="c-foot"><span>Xem tất cả mẫu</span><span class="c-go" aria-hidden="true">→</span></div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>
</Layout>
