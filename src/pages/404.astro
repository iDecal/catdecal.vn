---
import Layout from '../layouts/Layout.astro';
---
<Layout title="Không tìm thấy trang | CatDecal.vn">
  <div class="wrap">
    <div class="notfound">
      <div class="big">404</div>
      <h1 style="font-size: clamp(28px, 4vw, 40px)">Không tìm thấy trang này</h1>
      <p class="lead">Đường dẫn có thể đã đổi hoặc không còn tồn tại.</p>
      <a class="btn btn--primary" href="/">Về trang chủ</a>
    </div>
  </div>
</Layout>
