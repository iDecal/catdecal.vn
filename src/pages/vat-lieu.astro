---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
const accent = '#FFC928';
const useLabel: Record<string, string> = { kinh: 'Kính, cửa', xe: 'Xe', tuong: 'Tường, nội thất', qua: 'Quà tặng, đồ dùng' };
const mats: any[] = [
      {
        id: 'mau', name: 'Decal màu trơn',
        desc: 'Loại phổ biến nhất, bề mặt đồng màu, có nhiều màu để chọn. Cắt chữ, logo và họa tiết đều tốt, giá dễ tiếp cận. Nếu chưa biết chọn gì, bắt đầu từ loại này.',
        uses: ['kinh', 'xe', 'tuong', 'qua'],
        note: 'Chọn màu tương phản với nền để chữ dễ đọc. Màu quá nhạt trên kính sáng sẽ khó thấy.',
        bg: accent, fg: '#111', effect: 'Màu đồng nhất, không phản chiếu', best: 'Chữ dán kính, tường, tem xe thông thường', rnote: 'Màu nhạt khó đọc trên nền sáng'
      },
      {
        id: 'xi', name: 'Decal xi (ánh kim)',
        desc: 'Bề mặt phản chiếu như kim loại: xi vàng, xi bạc, đồng… Tạo cảm giác sang, nổi bật cho logo, bảng hiệu và tên cửa hàng.',
        uses: ['kinh', 'xe', 'qua'],
        note: 'Hiệu ứng rõ nhất ở chữ lớn, nét đơn giản. Bề mặt bóng dễ thấy vết xước và dấu tay, tránh dán nơi hay chà xát.',
        bg: 'linear-gradient(135deg, #B59A4A 0%, #F3E3A0 50%, #B59A4A 100%)', fg: '#6B5410', effect: 'Bóng, ánh kim loại', best: 'Logo, bảng hiệu, tên cửa hàng', rnote: 'Dễ lộ vết xước, nên dùng chữ lớn'
      },
      {
        id: 'quang', name: 'Decal phản quang',
        desc: 'Phản chiếu ánh đèn khi trời tối nên dễ nhận ra hơn. Thường dùng cho xe dịch vụ, xe tải, thùng hàng và biển cảnh báo.',
        uses: ['xe'],
        note: 'Chọn khi độ dễ thấy ban đêm là yêu cầu chính. Giá thường cao hơn decal trơn, hỏi bên mình để biết giá theo màu.',
        bg: 'repeating-linear-gradient(45deg, #F2F2F2 0 8px, #D4D4D4 8px 16px)', fg: '#111', effect: 'Sáng lên khi có đèn chiếu', best: 'Xe dịch vụ, xe tải, thùng hàng, biển báo', rnote: 'Giá cao hơn, ít màu hơn decal trơn'
      },
      {
        id: 'mo', name: 'Decal mờ dán kính',
        desc: 'Làm kính trông như được phun cát: che bớt tầm nhìn mà vẫn lấy sáng. Hợp với vách kính văn phòng, phòng họp, cửa phòng khám, tiệm làm đẹp.',
        uses: ['kinh'],
        note: 'Chỉ dán lên kính phẳng, sạch. Dán dải liền hoặc họa tiết, cần đo kỹ trước khi cắt.',
        bg: '#6F8E8B', fg: '#fff', dots: true, effect: 'Mờ đục như kính phun cát', best: 'Vách kính văn phòng, phòng họp, cửa kính cần riêng tư', rnote: 'Chỉ dùng cho bề mặt kính phẳng'
      },
      {
        id: 'trong', name: 'Decal trong',
        desc: 'Nền trong suốt để giữ độ nhìn xuyên qua, phù hợp khi muốn chữ hoặc hình nổi lên mà không che mất bề mặt phía sau.',
        uses: ['kinh', 'qua'],
        note: 'Phù hợp khi nền phía sau cần được giữ nguyên. Hỏi bên mình về loại trong có sẵn và khả năng cắt chữ nhỏ.',
        bg: '#E9E2D3', fg: '#111', checker: true, effect: 'Trong suốt', best: 'Kính, mặt nhựa trong, sản phẩm cần giữ nền', rnote: 'Cần hỏi loại và khả năng cắt chữ nhỏ'
      },
      {
        id: 'van', name: 'Decal vân (gỗ, carbon)',
        desc: 'Bề mặt có hoa văn giả gỗ hoặc sợi carbon, dùng để trang trí đồ nội thất, chi tiết xe hoặc đồ dùng cá nhân.',
        uses: ['tuong', 'xe', 'qua'],
        note: 'Hoa văn thấy rõ ở mảng lớn, chữ quá nhỏ sẽ khó nhận ra vân. Bề mặt dán cần phẳng.',
        bg: 'repeating-linear-gradient(90deg, #7A5A3A 0 6px, #8B6A47 6px 12px)', fg: '#FFF9E9', effect: 'Hoa văn gỗ hoặc carbon', best: 'Đồ nội thất, chi tiết trang trí, đồ dùng cá nhân', rnote: 'Hoa văn khó thấy ở chi tiết nhỏ'
      }
    ];
const tabs = [
  { id: 'all', label: 'Tất cả' }, { id: 'kinh', label: 'Kính & cửa' }, { id: 'xe', label: 'Xe' },
  { id: 'tuong', label: 'Tường & nội thất' }, { id: 'qua', label: 'Quà tặng' }
].map((x) => ({ ...x, cls: x.id === 'all' ? 'chip on' : 'chip' }));
const items = mats.map((m) => {
  let bg = m.bg;
  if (m.dots) bg = 'radial-gradient(rgba(255,255,255,0.45) 2px, transparent 2.5px) 0 0 / 12px 12px, ' + m.bg;
  if (m.checker) bg = 'conic-gradient(#D9D2C0 25%, #FFF9E9 0 50%, #D9D2C0 0 75%, #FFF9E9 0) 0 0 / 24px 24px';
  return {
    name: m.name, desc: m.desc, note: m.note,
    uses: m.uses.map((u: string) => useLabel[u]),
    useIds: m.uses.join(' '),
    swatchStyle: 'height: 150px; display: flex; align-items: center; justify-content: center; background: ' + bg,
    swatchTextStyle: 'font-weight: 900; font-size: 56px; letter-spacing: -0.03em; color: ' + m.fg
  };
});
const rows = mats.map((m) => ({ name: m.name, effect: m.effect, best: m.best, note: m.rnote }));
const brandCards = [
        { name: '3M', origin: 'Hoa Kỳ', desc: 'Tập đoàn vật liệu và giải pháp công nghiệp có dòng vật liệu đồ họa cho biển hiệu, quảng cáo và decal dán xe.', fit: 'Biển hiệu, decal dán xe, ứng dụng ngoài trời' },
        { name: 'Avery Dennison', origin: 'Hoa Kỳ', desc: 'Hãng chuyên vật liệu dán nhãn và vật liệu đồ họa, có các dòng decal cắt chữ và decal dán xe, dán kính.', fit: 'Decal cắt chữ, dán xe, dán kính' },
        { name: 'ORACAL', origin: 'Đức', desc: 'Thương hiệu của tập đoàn ORAFOL, quen thuộc với decal cắt chữ bằng máy plotter, có bảng màu trơn đa dạng.', fit: 'Chữ và logo cắt bằng máy, dán kính, tường, xe' },
        { name: '[THƯƠNG HIỆU KHÁC]', origin: '[XUẤT XỨ]', desc: '[MÔ TẢ NGẮN VỀ HÃNG]', fit: '[NƠI DÙNG PHÙ HỢP]' }
      ];
---
<Layout title="Vật liệu decal: màu trơn, xi, phản quang, mờ | CatDecal.vn" description="Hiểu rõ các loại vật liệu decal cắt chữ, nơi dùng phù hợp, lưu ý và các thương hiệu 3M, Avery Dennison, ORACAL." active="materials">

  <header class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Vật liệu</span>
      <h1 style="max-width: 18ch">Hiểu rõ vật liệu trước khi đặt cắt.</h1>
      <p class="lead">Cùng một nội dung chữ, nhưng decal màu, decal xi hay decal phản quang cho kết quả rất khác. Chọn nơi bạn định dán để xem loại phù hợp, rồi gửi file đặt cắt.</p>
    </div>
  </header>

  <section class="section--tight" style="padding: 40px 0 96px">
    <div class="wrap stack stack-6" style="gap: 28px">
      <div class="stack stack-3">
        <span class="field-label" style="font-weight: 800; font-size: 14px">Bạn định dán ở đâu?</span>
        <div class="chips" role="group" aria-label="Lọc vật liệu theo nơi dán">
          {tabs.map((tab) => (<>
            <button type="button" data-chip data-use={tab.id} class={tab.cls}>{tab.label}</button>
          </>))}
        </div>
      </div>
      <div class="grid grid--3">
        {items.map((m) => (<>
          <article data-card data-uses={m.useIds} class="card mat-card" style="display: flex; flex-direction: column">
            <div class="swatch" style={m.swatchStyle}><span style={m.swatchTextStyle}>Aa</span></div>
            <div class="m-body">
              <h2>{m.name}</h2>
              <p class="m-desc">{m.desc}</p>
              <div>
                <div class="m-label">Hợp với</div>
                <div class="chips-sm">{m.uses.map((u) => (<span>{u}</span>))}</div>
              </div>
              <div class="note-box"><b>Lưu ý:</b> {m.note}</div>
              <div class="meta-list">
                <div>Màu có sẵn: <b>[DANH SÁCH MÀU]</b></div>
                <div>Dùng ngoài trời: <b>[XÁC NHẬN THEO LOẠI DECAL]</b></div>
                <div>Giá: từ <b>[GIÁ]/m²</b></div>
              </div>
              <div style="margin-top: auto; padding-top: 6px"><a class="btn btn--primary btn--sm" href="/dich-vu/#yeu-cau">Đặt cắt loại này <span aria-hidden="true">↗</span></a></div>
            </div>
          </article>
        </>))}
      </div>
    </div>
  </section>

  <!-- So sánh -->
  <section class="section section--white">
    <div class="wrap stack stack-6" style="gap: 28px">
      <div class="sec-head" style="margin-bottom: 0"><div><span class="eyebrow">So sánh</span><h2 class="h2">So sánh nhanh</h2></div></div>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr><th scope="col">Loại decal</th><th scope="col">Hiệu ứng</th><th scope="col">Phù hợp nhất</th><th scope="col">Cần lưu ý</th></tr>
          </thead>
          <tbody>
            {rows.map((r) => (<>
              <tr><td>{r.name}</td><td>{r.effect}</td><td>{r.best}</td><td>{r.note}</td></tr>
            </>))}
          </tbody>
        </table>
      </div>
      <p class="form-note">Độ bền ngoài trời, độ dày và màu có sẵn thay đổi theo từng nhà sản xuất. Hỏi bên mình để biết thông số của loại decal đang có.</p>
    </div>
  </section>

  <!-- Thương hiệu -->
  <section class="section" id="thuong-hieu">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Thương hiệu</span>
          <h2 class="h2">Các hãng decal bên mình sử dụng</h2>
          <p>Mỗi hãng có nhiều dòng sản phẩm với đặc tính khác nhau. Bên mình tư vấn dòng phù hợp với nơi dán và ngân sách của bạn.</p>
        </div>
      </div>
      <div class="grid grid--4">
        {brandCards.map((b) => (<>
          <div class="card brand-card">
            <div class="top"><div class="name">{b.name}</div><span class="pill pill--line">{b.origin}</span></div>
            <p class="m-desc" style="font-size: 14.5px; line-height: 1.75; color: var(--ink-2)">{b.desc}</p>
            <div class="note-box" style="margin-top: auto"><div><b>Phù hợp:</b> {b.fit}</div><div><b>Dòng đang có:</b> [DÒNG SẢN PHẨM]</div></div>
          </div>
        </>))}
      </div>
      <p class="form-note" style="margin-top: 24px">Thông số kỹ thuật, độ bền và màu có sẵn do từng nhà sản xuất công bố theo từng dòng. Hỏi bên mình để biết loại đang có và bảng màu.</p>
    </div>
  </section>

  <section class="section--tight" style="padding: 0 0 96px">
    <div class="wrap">
      <div class="cta-band">
        <div class="copy"><h2>Chưa chắc nên chọn loại nào?</h2><p>Cho bên mình biết nơi dán và mục đích, bên mình gợi ý chất liệu và báo giá.</p></div>
        <div class="row">
          <a class="btn btn--primary" href="/dich-vu/#yeu-cau">Gửi file đặt cắt <span aria-hidden="true">↗</span></a>
          <a class="btn btn--ghost" href="/blog/chon-chat-lieu/">Đọc bài chọn chất liệu</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
<script>
  const chips = Array.from(document.querySelectorAll('[data-chip]'));
  const cards = Array.from(document.querySelectorAll('[data-card]'));
  chips.forEach((b) => b.addEventListener('click', () => {
    const u = b.dataset.use;
    chips.forEach((x) => { x.classList.toggle('on', x === b); x.setAttribute('aria-pressed', String(x === b)); });
    cards.forEach((c) => { c.hidden = !(u === 'all' || (c.dataset.uses || '').split(' ').includes(u)); });
  }));
</script>