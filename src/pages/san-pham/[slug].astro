---
import ContactIcon from '../../components/ContactIcon.astro';
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import categories from '../../data/categories.json';
import { products, relatedTo } from '../../data/products';
export function getStaticPaths() {
  return products.map((product) => ({ params: { slug: product.slug }, props: { product } }));
}
const { product } = Astro.props;
const p = product.page;
const category = categories.find((c) => c.slug === product.cat);
const colors = p.colors;
const sizes = p.sizes.map((label: string, idx: number) => ({ label, idx }));
const color0 = colors[0];
const related = relatedTo(product.slug);
const colorOpts = colors.map((c: any, idx: number) => ({ label: c.name, idx }));
const highlights = p.highlights;
const uses = p.uses;
const previewStyle = 'color: ' + color0.hex;
const dotStyle = 'background: ' + color0.hex;
const summary = p.name + ' · ' + p.sizes[1] + ' · Màu ' + color0.name.toLowerCase() + ' · SL 1';
const clientData = { name: p.name, sizes: p.sizes, colors, prices: product.samplePrices, discount: product.salePercent };
const money = (n: number) => new Intl.NumberFormat('vi-VN').format(n) + ' ₫';
const initialPrice = product.samplePrices[1];
const initialSale = product.salePercent ? Math.round(initialPrice * (100-product.salePercent)/100/1000)*1000 : initialPrice;
---
<Layout title={p.name + ' | CatDecal.vn'} description={p.desc} active="products">

  <section class="section--tight" style="padding-bottom: 88px">
    <div class="wrap stack stack-6" style="gap: 28px">
      <nav class="crumb" aria-label="Đường dẫn">
        <a href="/">Trang chủ</a><span aria-hidden="true">/</span>
        <a href="/san-pham/">Sản phẩm mẫu</a><span aria-hidden="true">/</span>
        {category && (<><a href={'/san-pham/danh-muc/' + category.slug + '/'}>{category.name}</a><span aria-hidden="true">/</span></>)}
        <span>{p.name}</span>
      </nav>

      <div class="product-grid">
        <!-- Xem trước -->
        <div class="preview-box">
          <div id="preview" class="preview" style={previewStyle}>
          {p.kind === 'kinh' && (<>
          <svg role="img" aria-label="Minh họa chữ decal dán trên kính cửa hàng" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><rect x="0" y="0" width="40" height="34" fill="#FFC400"></rect><rect x="40" y="0" width="40" height="34" fill="#FFFFFF"></rect><rect x="80" y="0" width="40" height="34" fill="#FFC400"></rect><rect x="120" y="0" width="40" height="34" fill="#FFFFFF"></rect><rect x="160" y="0" width="40" height="34" fill="#FFC400"></rect><rect x="200" y="0" width="40" height="34" fill="#FFFFFF"></rect><rect x="240" y="0" width="40" height="34" fill="#FFC400"></rect><rect x="280" y="0" width="40" height="34" fill="#FFFFFF"></rect><rect x="20" y="46" width="280" height="128" rx="6" fill={p.surface} stroke="#111" stroke-width="3"></rect><path d="M60 46 L112 174 M124 46 L176 174" stroke="#fff" stroke-opacity="0.16" stroke-width="14"></path><text x="160" y="120" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="44" fill="currentColor">{p.sample}</text><rect x="106" y="136" width="108" height="6" rx="3" fill="currentColor" fill-opacity="0.8"></rect></svg>
        </>)}
          {p.kind === 'mo' && (<>
          <svg role="img" aria-label="Minh họa decal mờ dán vách kính văn phòng" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><defs><pattern id="pDots" width="6" height="6" patternUnits="userSpaceOnUse"><circle cx="3" cy="3" r="1.4" fill="#111" fill-opacity="0.3"></circle></pattern></defs><rect x="14" y="14" width="136" height="152" fill={p.surface} stroke="#111" stroke-width="3"></rect><rect x="170" y="14" width="136" height="152" fill={p.surface} stroke="#111" stroke-width="3"></rect><circle cx="82" cy="50" r="12" fill="#111" fill-opacity="0.3"></circle><rect x="62" y="64" width="40" height="60" rx="16" fill="#111" fill-opacity="0.3"></rect><text x="160" y="46" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="28" fill="currentColor">{p.sample}</text><rect x="14" y="96" width="292" height="40" fill="currentColor" fill-opacity="0.85"></rect><rect x="14" y="96" width="292" height="40" fill="url(#pDots)"></rect></svg>
        </>)}
          {p.kind === 'xe' && (<>
          <svg role="img" aria-label="Minh họa chữ decal dán trên thân xe" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><rect y="150" width="320" height="30" fill="#D3C9B3"></rect><path d="M78 92 L104 58 L206 58 L240 92 Z" fill={p.surface} stroke="#111" stroke-width="3" stroke-linejoin="round"></path><path d="M92 90 L110 64 L152 64 L152 90 Z" fill="#D9E6E4"></path><path d="M160 64 L202 64 L226 90 L160 90 Z" fill="#D9E6E4"></path><rect x="24" y="90" width="282" height="52" rx="14" fill={p.surface} stroke="#111" stroke-width="3"></rect><text x="165" y="125" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="26" fill="currentColor">{p.sample}</text><circle cx="90" cy="144" r="20" fill="#111"></circle><circle cx="90" cy="144" r="8" fill="#9A9A94"></circle><circle cx="240" cy="144" r="20" fill="#111"></circle><circle cx="240" cy="144" r="8" fill="#9A9A94"></circle></svg>
        </>)}
          {p.kind === 'quang' && (<>
          <svg role="img" aria-label="Minh họa decal phản quang trên thùng xe lúc trời tối" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><defs><pattern id="pStripe" width="20" height="20" patternUnits="userSpaceOnUse" patternTransform="rotate(45)"><rect width="10" height="20" fill="currentColor"></rect></pattern></defs><rect width="320" height="180" rx="12" fill="#1C1F26"></rect><circle cx="40" cy="148" r="44" fill="currentColor" fill-opacity="0.22"></circle><circle cx="280" cy="148" r="44" fill="currentColor" fill-opacity="0.22"></circle><rect x="70" y="22" width="180" height="118" rx="6" fill={p.surface} stroke="#9A9A94" stroke-width="3"></rect><line x1="160" y1="22" x2="160" y2="140" stroke="#9A9A94" stroke-width="2"></line><text x="160" y="80" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="36" fill="currentColor">{p.sample}</text><rect x="70" y="102" width="180" height="20" fill="url(#pStripe)"></rect><rect x="64" y="140" width="192" height="10" rx="3" fill="#111"></rect><rect x="90" y="150" width="28" height="18" rx="3" fill="#111"></rect><rect x="202" y="150" width="28" height="18" rx="3" fill="#111"></rect></svg>
        </>)}
          {p.kind === 'tuong' && (<>
          <svg role="img" aria-label="Minh họa chữ decal dán trên tường phòng khách" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><rect x="0" y="0" width="320" height="150" fill={p.surface}></rect><rect y="150" width="320" height="30" fill="#C9B8A3"></rect><text x="160" y="76" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="800" font-size="44" fill="currentColor">{p.sample}</text><rect x="80" y="94" width="160" height="34" rx="12" fill="#6F8E8B"></rect><rect x="70" y="118" width="180" height="32" rx="12" fill="#5E7C80"></rect><rect x="84" y="150" width="8" height="10" fill="#111"></rect><rect x="228" y="150" width="8" height="10" fill="#111"></rect><rect x="270" y="124" width="26" height="26" rx="4" fill="#111"></rect><ellipse cx="283" cy="108" rx="9" ry="20" fill="#3F7A4F"></ellipse><ellipse cx="270" cy="114" rx="7" ry="15" fill="#4D9460" transform="rotate(-25 270 114)"></ellipse><ellipse cx="296" cy="114" rx="7" ry="15" fill="#4D9460" transform="rotate(25 296 114)"></ellipse></svg>
        </>)}
          {p.kind === 'ten' && (<>
          <svg role="img" aria-label="Minh họa tên decal dán trên bình nước và laptop" viewBox="0 0 320 180" style="width: 100%; max-width: 640px; height: auto; display: block"><rect x="104" y="12" width="56" height="16" rx="4" fill="#111"></rect><rect x="96" y="28" width="72" height="138" rx="16" fill={p.surface} stroke="#111" stroke-width="3"></rect><text x="132" y="104" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="24" fill="currentColor">{p.sample}</text><rect x="196" y="58" width="108" height="72" rx="6" fill={p.surface} stroke="#111" stroke-width="3"></rect><rect x="186" y="130" width="128" height="9" rx="4" fill="#111"></rect><text x="250" y="108" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="36" fill="currentColor">M</text></svg>
        </>)}
          </div>
          <div class="product-gallery" role="group" aria-label="Chọn góc xem sản phẩm">
            <button class="gallery-thumb is-active" type="button" data-view="normal" aria-label="Xem mẫu tổng thể" aria-pressed="true"><span class="gallery-thumb-image" aria-hidden="true"></span><span class="gallery-thumb-label">Tổng thể</span></button>
            <button class="gallery-thumb" type="button" data-view="detail" aria-label="Xem cận cảnh mẫu" aria-pressed="false"><span class="gallery-thumb-image" aria-hidden="true"></span><span class="gallery-thumb-label">Cận cảnh</span></button>
            <button class="gallery-thumb" type="button" data-view="context" aria-label="Xem mẫu ở góc rộng" aria-pressed="false"><span class="gallery-thumb-image" aria-hidden="true"></span><span class="gallery-thumb-label">Góc rộng</span></button>
          </div>
        </div>

        <!-- Thông tin -->
        <div class="buy-panel">
          <div class="stack stack-4">
            <div class="product-flags"><span class="eyebrow">{p.tag}</span>{product.featured && <span class="product-badge product-badge--featured">Nổi bật</span>}{product.salePercent > 0 && <span class="product-badge product-badge--sale">−{product.salePercent}%</span>}</div>
            <h1>{p.name}</h1>
            <div class="price-display" aria-live="polite"><span id="p-price" class="price-current">{money(initialSale)}</span>{product.salePercent > 0 && <del id="p-old-price" class="price-old">{money(initialPrice)}</del>}</div><p class="sample-price-note">Giá mẫu tham khảo theo kích thước, chưa phải báo giá chính thức.</p>
            <p class="lead" style="font-size: 16.5px">{p.desc}</p>
          </div>

          <div class="options">
            <div class="opt">
              <label for="p-size">Kích thước</label>
              <select id="p-size" class="select">
                {sizes.map((s) => (<>
                  <option value={s.idx} selected={s.idx === 1}>{s.label}</option>
                </>))}
              </select>
            </div>
            <div class="opt">
              <label for="p-color">Màu decal</label>
              <div class="row" style="gap: 12px; flex-wrap: nowrap">
                <span id="p-dot" class="color-dot" aria-hidden="true" style={dotStyle}></span>
                <select id="p-color" class="select" style="min-width: 170px">
                  {colorOpts.map((c) => (<>
                    <option value={c.idx}>{c.label}</option>
                  </>))}
                </select>
              </div>
            </div>
            <div class="opt">
              <label for="p-qty">Số lượng</label>
              <input id="p-qty" class="input" type="number" min="1" value="1" style="width: 120px; min-width: 0" />
            </div>
          </div>

          <div class="summary"><b>Bạn đã chọn:</b> <span id="p-summary">{summary}</span></div>

          <div class="row">
            <a class="btn btn--primary" href="/dich-vu/#yeu-cau">Gửi yêu cầu đặt hàng <span aria-hidden="true">↗</span></a>
            <a class="btn btn--ghost" href="tel:0866077040"><ContactIcon name="phone" /> Gọi 0866 077 040</a>
          </div>
          <ul class="assure">
            <li>Duyệt mẫu trước khi cắt</li>
            <li>Kèm lớp định hình dễ dán</li>
            <li>Giao hàng toàn quốc</li>
          </ul>
        </div>
      </div>
    </div>
  </section>

  <!-- Chi tiết -->
  <section class="section section--white">
    <div class="wrap two-col">
      <div class="stack stack-5">
        <span class="eyebrow">Chi tiết mẫu</span>
        <h2 class="h2" style="font-size: clamp(26px, 3vw, 34px)">Điểm nổi bật</h2>
        <ul class="checklist">
          {highlights.map((h) => (<li>{h}</li>))}
        </ul>
      </div>
      <div class="stack stack-5">
        <span class="eyebrow">Ứng dụng</span>
        <h2 class="h2" style="font-size: clamp(26px, 3vw, 34px)">Phù hợp để dán</h2>
        <div class="uses">
          {uses.map((u) => (<span>{u}</span>))}
        </div>
        <p class="muted" style="line-height: 1.8">Cần đổi nội dung chữ, đổi font hoặc kích thước riêng? Gửi yêu cầu, bên mình chỉnh mẫu và báo giá trước khi cắt.</p>
        <div><a class="link-arrow" href="/dich-vu/#yeu-cau">Gửi yêu cầu chỉnh mẫu →</a></div>
      </div>
    </div>
  </section>

  <!-- Sản phẩm liên quan -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head">
        <div><span class="eyebrow">Gợi ý thêm</span><h2 class="h2">Sản phẩm liên quan</h2></div>
        <a class="link-arrow" href="/san-pham/">Xem tất cả danh mục →</a>
      </div>
      <div class="grid grid--3">
        {related.map((r) => (<>
          <a class="card card--link p-card" href={r.href}>
            <div class="media"><Scene scene={r.scene} ink={r.ink} label={r.sample} /></div>
            <div class="p-body">
              <h3>{r.name}</h3>
              <p class="p-desc">{r.desc}</p>
              <div class="p-foot"><span>Xem chi tiết</span><span class="p-go" aria-hidden="true">→</span></div>
            </div>
          </a>
        </>))}
      </div>
    </div>
  </section>

</Layout>
<script define:vars={{ clientData }}>
  const { name, sizes, colors, prices, discount } = clientData;
  const money = (n) => new Intl.NumberFormat('vi-VN').format(n) + ' ₫';
  const $ = (id) => document.getElementById(id);
  function update() {
    const col = colors[Number($('p-color').value)];
    $('preview').style.color = col.hex;
    $('p-dot').style.background = col.hex;
    const q = Math.max(1, parseInt($('p-qty').value, 10) || 1);
    const base = prices[Number($('p-size').value)];
    const unit = discount ? Math.round(base * (100-discount)/100/1000)*1000 : base;
    $('p-price').textContent = money(unit * q);
    const oldPrice = $('p-old-price');
    if (oldPrice) oldPrice.textContent = money(base * q);
    $('p-summary').textContent = name + ' · ' + sizes[Number($('p-size').value)] + ' · Màu ' + col.name.toLowerCase() + ' · SL ' + q;
  }
  ['p-size', 'p-color', 'p-qty'].forEach((id) => $(id).addEventListener('input', update));
  const mainPreview = $('preview');
  const originalSvg = mainPreview.querySelector('svg');
  const galleryButtons = document.querySelectorAll('.gallery-thumb');
  galleryButtons.forEach((button) => {
    const slot = button.querySelector('.gallery-thumb-image');
    if (originalSvg && slot) {
      const thumbnail = originalSvg.cloneNode(true);
      thumbnail.removeAttribute('role');
      thumbnail.removeAttribute('aria-label');
      thumbnail.setAttribute('aria-hidden', 'true');
      thumbnail.removeAttribute('style');
      // Mỗi hình thu nhỏ dùng cùng mẫu SVG, nhưng có góc xem khác nhau.
      slot.appendChild(thumbnail);
    }
    button.addEventListener('click', () => {
      mainPreview.dataset.view = button.dataset.view;
      galleryButtons.forEach((item) => {
        const selected = item === button;
        item.classList.toggle('is-active', selected);
        item.setAttribute('aria-pressed', String(selected));
      });
    });
  });
</script>
