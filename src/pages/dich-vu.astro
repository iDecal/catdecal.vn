---
import ContactIcon from '../components/ContactIcon.astro';
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
import services from '../data/services.json';
const steps = [
  { t: 'Kiểm tra file', d: 'Xem nét cắt, kích thước và chất liệu, báo lại nếu cần chỉnh.' },
  { t: 'Báo giá và duyệt mẫu', d: 'Gửi giá và bản xem trước. Bạn xác nhận rồi mới cắt.' },
  { t: 'Cắt và phủ lớp định hình', d: 'Cắt bằng máy, bóc phần thừa, phủ lớp định hình giữ nguyên vị trí chữ.' },
  { t: 'Giao hàng', d: 'Đóng gói phẳng, gửi toàn quốc. Thời gian dự kiến: [SỐ NGÀY].' }
];
const faqs = [
  { q: 'Tôi không có file thiết kế thì sao?', a: 'Mô tả nội dung, font mong muốn và kích thước trong phần ghi chú. Bên mình dựng mẫu để bạn duyệt trước khi cắt.' },
  { q: 'Chữ nhỏ nhất cắt được là bao nhiêu?', a: 'Phụ thuộc chất liệu và độ mảnh của nét chữ. Giới hạn hiện tại: [KÍCH THƯỚC TỐI THIỂU]. Gửi file để bên mình kiểm tra.' },
  { q: 'Có nhận đơn số lượng lớn không?', a: 'Có. Ghi số lượng trong form, bên mình báo giá theo từng mốc.' }
];
---
<Layout title="Cắt decal theo yêu cầu: gửi file nhận báo giá | CatDecal.vn" description="Gửi file thiết kế, chọn chất liệu, kích thước và số lượng. Nhận báo giá và mẫu duyệt trước khi cắt." active="service">

  <header class="page-hero">
    <div class="wrap">
      <span class="eyebrow">Dịch vụ</span>
      <h1 style="max-width: 20ch">Cắt decal theo yêu cầu: gửi file, nhận decal đã cắt.</h1>
      <p class="lead">Chọn file thiết kế của bạn, cho biết chất liệu, kích thước và số lượng. Bên mình báo giá, gửi mẫu duyệt rồi mới cắt. Mỗi đơn đều có lớp định hình để bạn dán dễ.</p>
      <div class="row"><a class="btn btn--primary" href="#yeu-cau">Gửi yêu cầu báo giá <span aria-hidden="true">↓</span></a><a class="btn btn--ghost" href="tel:0866077040"><ContactIcon name="phone" /> Gọi 0866 077 040</a></div>
    </div>
  </header>

  <section class="section" id="danh-sach">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Dịch vụ gia công</span>
          <h2 class="h2">Chọn giải pháp phù hợp với nhu cầu</h2>
          <p>Từ file thiết kế đến chữ dán kính, logo và tem nhãn — CatDecal hỗ trợ kiểm tra file, tư vấn vật liệu, sản xuất tại TP.HCM và giao hàng toàn quốc.</p>
        </div>
      </div>
      <div class="grid grid--catalog">
        {services.map((s, i) => (
          <a class="card card--link c-card service-card" href={'/dich-vu/' + s.slug + '/'}>
            <div class="media"><span class="num-badge">0{i + 1}</span><Scene scene={s.scene} ink={s.ink} label={s.sample} /></div>
            <div class="c-body">
              <h3>{s.name}</h3>
              <p class="c-desc">{s.short}</p>
              <div class="c-foot"><span>Xem hình mẫu & chi tiết dịch vụ</span><span class="c-go" aria-hidden="true">↗</span></div>
            </div>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- Form -->
  <section class="section section--white" id="yeu-cau">
    <div class="wrap">
      <div class="sec-head">
        <div>
          <span class="eyebrow">Gửi yêu cầu</span>
          <h2 class="h2">Gửi file nhận báo giá</h2>
          <p>Điền thông tin cơ bản và đính kèm file thiết kế. Chưa có file? Mô tả ý tưởng ở phần ghi chú.</p>
        </div>
      </div>
      <div class="form-grid">
        <div class="form-card">
          <div class="form-section">
            <div class="form-title"><i>1</i>Chọn file thiết kế</div>
            <label for="f-file" id="drop" class="dropzone">
              <span class="up" aria-hidden="true"><svg width="26" height="26" viewBox="0 0 36 36"><path d="M18 24 V8 M11 14 L18 7 L25 14" stroke="#18150F" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path><path d="M6 22 V28 Q6 30 8 30 H28 Q30 30 30 28 V22" stroke="#18150F" stroke-width="3" fill="none" stroke-linecap="round"></path></svg></span>
              <b>Bấm để chọn file hoặc kéo thả vào đây</b>
              <small>AI, SVG, PDF, CDR, EPS, DXF, PNG, JPG · tối đa 5 file, mỗi file 20 MB</small>
              <input id="f-file" type="file" multiple accept=".ai,.svg,.pdf,.cdr,.eps,.dxf,.png,.jpg,.jpeg" />
            </label>
            <div id="f-errors" class="alert" hidden role="alert"></div>
            <div id="f-list" class="stack stack-2"></div>
          </div>

          <div class="form-section">
            <div class="form-title"><i>2</i>Thông tin đơn cắt</div>
            <div class="fields fields--mobile-pair">
              <div class="field"><label for="s-ten">Họ tên</label><input id="s-ten" class="input" type="text" autocomplete="name" /></div>
              <div class="field"><label for="s-sdt">Số điện thoại / Zalo</label><input id="s-sdt" class="input" type="text" inputmode="tel" autocomplete="tel" /></div>
              <div class="field">
                <label for="s-cl"><span>Chất liệu</span><a href="/vat-lieu/">Xem các loại vật liệu →</a></label>
                <select id="s-cl" class="select">
                  <option>Decal màu trơn</option>
                  <option>Decal ánh kim</option>
                  <option>Decal phản quang</option>
                  <option>Decal mờ dán kính</option>
                  <option>Chưa rõ, cần tư vấn</option>
                </select>
              </div>
              <div class="field"><label for="s-mau">Màu decal</label><input id="s-mau" class="input" type="text" /></div>
            </div>
            <div class="fields fields--3 fields--mobile-size">
              <div class="field"><label for="s-rong">Rộng (cm)</label><input id="s-rong" class="input" type="text" inputmode="decimal" /></div>
              <div class="field"><label for="s-cao">Cao (cm)</label><input id="s-cao" class="input" type="text" inputmode="decimal" /></div>
              <div class="field"><label for="s-sl">Số lượng</label><input id="s-sl" class="input" type="text" inputmode="numeric" value="1" /></div>
            </div>
            <label for="s-lop" class="check"><input id="s-lop" type="checkbox" checked />Kèm lớp định hình (giấy chuyển) để dễ dán</label>
            <div class="field"><label for="s-note">Ghi chú (nơi dán, yêu cầu riêng)</label><textarea id="s-note" class="input" rows="3" style="resize: vertical"></textarea></div>
          </div>

          <div class="form-section">
            <div class="form-title"><i>3</i>Gửi yêu cầu</div>
            <label style="font-size:12px;display:none" aria-hidden="true">Để trống trường này<input id="s-website" tabindex="-1" autocomplete="off" /></label>
            <div class="row">
              <button type="button" id="btn-upload" class="btn btn--dark">Gửi báo giá kèm file</button>
              <button type="button" id="btn-mail" class="btn btn--primary"><ContactIcon name="mail" /> Gửi yêu cầu qua email</button>
              <button type="button" id="btn-copy" class="btn btn--ghost">Sao chép nội dung gửi Zalo</button>
            </div>
            <div id="f-status" class="status" hidden role="status"></div>
          </div>
        </div>

        <!-- Bên phải -->
        <aside class="stack stack-5" style="gap: 20px; position: sticky; top: 100px">
          <div class="side-card side-card--ink">
            <h3>File nên chuẩn bị</h3>
            <p style="font-size: 14.5px; line-height: 1.8">Tốt nhất là file vector (AI, SVG, PDF, CDR, EPS, DXF) với chữ đã chuyển thành đường (outline). Ảnh PNG/JPG vẫn nhận, bên mình sẽ dựng lại nét cắt và báo phí nếu cần: [PHÍ DỰNG FILE].</p>
          </div>
          <div class="side-card side-card--white">
            <h3>Bảng giá tham khảo</h3>
            <div class="price-list">
              <div><span>Decal màu trơn</span><b>[GIÁ]/m²</b></div>
              <div><span>Decal ánh kim</span><b>[GIÁ]/m²</b></div>
              <div><span>Decal phản quang</span><b>[GIÁ]/m²</b></div>
              <div><span>Decal mờ dán kính</span><b>[GIÁ]/m²</b></div>
            </div>
            <p class="form-note" style="font-size: 12.5px">Giá cuối cùng phụ thuộc độ phức tạp của nét cắt và số lượng. Bên mình báo giá chính xác sau khi xem file.</p>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Quy trình -->
  <section class="section section--ink">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">Quy trình</span><h2 class="h2">Sau khi bạn gửi file</h2></div></div>
      <ol class="steps" style="list-style: none; padding: 0; margin: 0">
        {steps.map((st, i) => (<li class="step"><span class="n">{i + 1}</span><h3>{st.t}</h3><p>{st.d}</p></li>))}
      </ol>
    </div>
  </section>

  <!-- Hỏi đáp -->
  <section class="section">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">Hỏi đáp</span><h2 class="h2">Câu hỏi thường gặp</h2></div></div>
      <div class="faq-grid">
        {faqs.map((f) => (<div class="faq"><b>{f.q}</b><p>{f.a}</p></div>))}
      </div>
    </div>
  </section>

</Layout>
<script>
  const $ = (id) => document.getElementById(id);
  const okExt = ['ai', 'svg', 'pdf', 'cdr', 'eps', 'dxf', 'png', 'jpg', 'jpeg'];
  const maxSize = 20 * 1024 * 1024;
  let files = [];
  const fmt = (b) => (b < 1024 ? b + ' B' : b < 1048576 ? (b / 1024).toFixed(0) + ' KB' : (b / 1048576).toFixed(1) + ' MB');
  function showErrors(errs) {
    const box = $('f-errors');
    box.innerHTML = '';
    errs.forEach((t) => { const d = document.createElement('div'); d.textContent = t; box.appendChild(d); });
    box.hidden = errs.length === 0;
  }
  function setStatus(t) { const s = $('f-status'); s.textContent = t; s.hidden = !t; }
  function renderFiles() {
    const box = $('f-list');
    box.innerHTML = '';
    files.forEach((f, i) => {
      const row = document.createElement('div');
      row.className = 'file-row';
      const info = document.createElement('div');
      info.className = 'info';
      const n = document.createElement('span'); n.className = 'name'; n.textContent = f.name;
      const s = document.createElement('span'); s.className = 'size'; s.textContent = fmt(f.size);
      info.append(n, s);
      const btn = document.createElement('button');
      btn.type = 'button'; btn.textContent = 'Bỏ'; btn.setAttribute('aria-label', 'Bỏ file ' + f.name);
      btn.className = 'btn btn--ghost btn--sm';
      btn.addEventListener('click', () => { files = files.filter((_, j) => j !== i); setStatus(''); renderFiles(); });
      row.append(info, btn);
      box.appendChild(row);
    });
  }
  function addFiles(list) {
    const errors = [];
    list.forEach((f) => {
      const ext = (f.name.split('.').pop() || '').toLowerCase();
      if (!okExt.includes(ext)) { errors.push('"' + f.name + '": định dạng chưa được nhận.'); return; }
      if (f.size > maxSize) { errors.push('"' + f.name + '": lớn hơn 20 MB.'); return; }
      if (files.some((x) => x.name === f.name && x.size === f.size)) return;
      if (files.length >= 5) { errors.push('"' + f.name + '": đã đủ 5 file.'); return; }
      files.push(f);
    });
    showErrors(errors); setStatus(''); renderFiles();
  }
  const drop = $('drop');
  drop.addEventListener('dragover', (e) => { e.preventDefault(); drop.classList.add('drag'); });
  drop.addEventListener('dragleave', () => { drop.classList.remove('drag'); });
  drop.addEventListener('drop', (e) => {
    e.preventDefault(); drop.classList.remove('drag');
    addFiles(e.dataTransfer && e.dataTransfer.files ? Array.from(e.dataTransfer.files) : []);
  });
  $('f-file').addEventListener('change', (e) => { addFiles(Array.from(e.target.files || [])); try { e.target.value = ''; } catch (err) {} });
  function val(id) { return $(id).value.trim(); }
  function buildText() {
    return [
      'YÊU CẦU CẮT DECAL THEO YÊU CẦU',
      'Họ tên: ' + (val('s-ten') || '—'),
      'SĐT / Zalo: ' + (val('s-sdt') || '—'),
      'Chất liệu: ' + $('s-cl').value,
      'Màu decal: ' + (val('s-mau') || '—'),
      'Kích thước (rộng x cao, cm): ' + (val('s-rong') || '—') + ' x ' + (val('s-cao') || '—'),
      'Số lượng: ' + (val('s-sl') || '1'),
      'Lớp định hình: ' + ($('s-lop').checked ? 'Có' : 'Không'),
      'File đính kèm: ' + (files.map((f) => f.name).join(', ') || '—'),
      'Ghi chú: ' + (val('s-note') || '—')
    ].join('\n');
  }
  function check() {
    const errors = [];
    if (!val('s-ten')) errors.push('Vui lòng nhập họ tên.');
    if (!val('s-sdt')) errors.push('Vui lòng nhập số điện thoại hoặc Zalo.');
    if (!files.length) errors.push('Vui lòng chọn ít nhất một file thiết kế.');
    showErrors(errors);
    return errors.length === 0;
  }
  $('btn-upload').addEventListener('click', async () => {
    if (!check()) return;
    const button = $('btn-upload');
    button.disabled = true;
    button.textContent = 'Đang gửi file...';
    setStatus('Đang tải file và yêu cầu lên hệ thống, vui lòng giữ trang này mở.');
    try {
      const form = new FormData();
      form.append('name', val('s-ten'));
      form.append('phone', val('s-sdt'));
      form.append('material', $('s-cl').value);
      form.append('color', val('s-mau'));
      form.append('width', val('s-rong'));
      form.append('height', val('s-cao'));
      form.append('quantity', val('s-sl'));
      form.append('transferLayer', $('s-lop').checked ? 'yes' : 'no');
      form.append('note', val('s-note'));
      form.append('website', val('s-website'));
      files.forEach(file => form.append('files', file, file.name));
      const response = await fetch('/api/bao-gia', { method: 'POST', body: form });
      const result = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(result.error || 'Không thể gửi yêu cầu.');
      setStatus('Đã nhận yêu cầu #' + result.id + '. Vui lòng lưu mã này để đối chiếu.');
      files = []; renderFiles(); showErrors([]);
    } catch (error) {
      setStatus('Chưa gửi thành công: ' + (error instanceof Error ? error.message : 'Lỗi kết nối') + '. Bạn có thể dùng email hoặc Zalo bên cạnh.');
    } finally {
      button.disabled = false; button.textContent = 'Gửi báo giá kèm file';
    }
  });
  $('btn-mail').addEventListener('click', () => {
    if (!check()) return;
    const href = 'mailto:xinchao@catdecal.vn?subject=' + encodeURIComponent('Yêu cầu cắt decal theo yêu cầu') + '&body=' + encodeURIComponent(buildText() + '\n\n(Vui lòng đính kèm các file đã chọn.)');
    setStatus('Đang mở email với thông tin đơn. Hãy đính kèm ' + files.length + ' file đã chọn rồi gửi. Nếu email không mở, bấm "Sao chép nội dung gửi Zalo".');
    window.location.href = href;
  });
  $('btn-copy').addEventListener('click', () => {
    if (!check()) return;
    const text = buildText();
    const done = () => setStatus('Đã sao chép nội dung đơn. Dán vào Zalo 0866077040 và gửi kèm ' + files.length + ' file đã chọn.');
    const fail = () => setStatus('Trình duyệt không cho sao chép tự động. Hãy chép tay thông tin đơn rồi gửi cùng file qua Zalo.');
    try {
      if (navigator.clipboard && navigator.clipboard.writeText) navigator.clipboard.writeText(text).then(done, fail);
      else fail();
    } catch (err) { fail(); }
  });
</script>