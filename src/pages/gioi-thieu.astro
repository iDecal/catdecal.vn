---
import Layout from '../layouts/Layout.astro';
import Scene from '../components/Scene.astro';
const list = [
  { title: 'Dán chữ lên kính cửa hàng', length: '[THỜI LƯỢNG]', desc: 'Cách làm sạch kính, đặt vị trí, miết và bóc lớp định hình để chữ thẳng hàng và không bọt khí.' },
  { title: 'Dán decal lên xe', length: '[THỜI LƯỢNG]', desc: 'Cách dán lên thân xe và kính xe, xử lý bề mặt cong và các góc khó.' },
  { title: 'Dán chữ lên tường', length: '[THỜI LƯỢNG]', desc: 'Cách dán lên tường sơn phẳng, căn thẳng dòng chữ lớn mà không cần khoan hay đục.' }
];
const active = list[0];
const videos = list.map((v, i) => ({ ...v, i, cls: i === 0 ? 'vbtn on' : 'vbtn' }));
---
<Layout title="Về chúng tôi | CatDecal.vn" description="Máy cắt của Nhật, decal có lớp định hình dễ dán và video hướng dẫn từng bước." active="about">

  <header class="page-hero page-hero--split">
    <div class="wrap">
      <div class="copy">
        <span class="eyebrow">Về chúng tôi</span>
        <h1 style="max-width: 14ch">Cắt chuẩn từng nét, dán dễ từng bước.</h1>
        <p class="lead">CatDecal.vn chuyên bán decal cắt chữ làm sẵn và nhận cắt decal theo yêu cầu. Chúng tôi tập trung vào ba việc: cắt chính xác, giúp người mua dán dễ, và hướng dẫn tận tình bằng video.</p>
        <p class="muted" style="max-width: 56ch">[Viết 2–3 câu về câu chuyện của bạn: bắt đầu từ khi nào, tại sao làm decal, phục vụ ai.]</p>
      </div>
      <div class="frame" style="background: var(--ink); padding: 26px"><svg role="img" aria-label="Đường dao cắt đi quanh chữ A trên tấm decal" viewBox="0 0 520 320" style="width: 100%; height: auto; display: block">
          <rect width="520" height="320" rx="12" fill="#1E1E1E"></rect>
          <text x="260" y="230" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="220" fill="#FFC400" stroke="#FFFFFF" stroke-width="2.5" stroke-dasharray="9 7" paint-order="stroke">Aa</text>
          <text x="32" y="296" font-family="Be Vietnam Pro, sans-serif" font-weight="600" font-size="15" fill="#FFFFFF">Đường dao theo sát nét chữ</text>
        </svg></div>
    </div>
  </header>

  <!-- 3 điểm khác biệt -->
  <section class="section section--ink">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">Điểm khác biệt</span><h2 class="h2">Ba điều làm nên khác biệt</h2></div></div>
      <div class="grid grid--3">
        <div class="feature">
          <span class="no">01</span>
          <svg role="img" aria-label="Minh họa máy cắt decal với tấm decal đang được cắt" viewBox="0 0 240 100" style="width: 100%; max-width: 280px; height: auto; display: block"><rect x="24" y="14" width="192" height="44" rx="8" fill="#FFC400" stroke="#FFFFFF" stroke-width="2"></rect><rect x="40" y="28" width="160" height="8" rx="4" fill="#111"></rect><path d="M112 20 L128 20 L120 40 Z" fill="#111"></path><rect x="52" y="50" width="136" height="40" rx="4" fill="#FFFFFF"></rect><text x="120" y="82" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="30" fill="none" stroke="#111" stroke-width="1.5" stroke-dasharray="4 3">Aa</text></svg>
          <h3>Máy cắt của Nhật</h3>
          <p>Chúng tôi dùng máy cắt decal sản xuất tại Nhật [TÊN MÁY / HÃNG]. Dao cắt ổn định giúp đường cắt sạch, chữ nhỏ và nét mảnh vẫn giữ được hình dáng, góc chữ sắc, không bị rách hay dính chân chữ.</p>
        </div>
        <div class="feature">
          <span class="no">02</span>
          <svg role="img" aria-label="Minh họa lớp định hình đang được bóc khỏi chữ decal" viewBox="0 0 240 100" style="width: 100%; max-width: 280px; height: auto; display: block"><rect x="30" y="30" width="160" height="50" rx="6" fill="#FFC400"></rect><text x="110" y="68" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="900" font-size="32" fill="#111">AB</text><path d="M30 30 H190 V64 L168 80 H30 Z" fill="#FFFFFF" fill-opacity="0.35" stroke="#FFFFFF" stroke-width="2" stroke-dasharray="5 4"></path><path d="M190 30 L214 14 L214 52 L190 64 Z" fill="#FFFFFF" fill-opacity="0.6" stroke="#FFFFFF" stroke-width="2"></path></svg>
          <h3>Lớp định hình dễ dán</h3>
          <p>Mỗi sản phẩm đều có lớp định hình (giấy chuyển) phủ lên mặt chữ. Lớp này giữ nguyên khoảng cách giữa các chữ và các nét, bạn chỉ cần đặt cả tấm lên bề mặt, miết rồi bóc lớp định hình ra là xong.</p>
        </div>
        <div class="feature">
          <span class="no">03</span>
          <svg role="img" aria-label="Minh họa màn hình phát video hướng dẫn" viewBox="0 0 240 100" style="width: 100%; max-width: 280px; height: auto; display: block"><rect x="40" y="10" width="160" height="66" rx="8" fill="none" stroke="#FFFFFF" stroke-width="3"></rect><path d="M108 28 L136 43 L108 58 Z" fill="#FFC400"></path><rect x="96" y="84" width="48" height="5" rx="2.5" fill="#FFFFFF"></rect><rect x="52" y="64" width="90" height="4" rx="2" fill="#FFC400"></rect></svg>
          <h3>Có video hướng dẫn</h3>
          <p>Mỗi loại bề mặt như kính, xe, tường đều có video hướng dẫn dán từng bước. Bạn xem một lần là tự dán được, không cần có kinh nghiệm.</p>
        </div>
      </div>
    </div>
  </section>

  <!-- Lớp định hình -->
  <section class="section">
    <div class="wrap split">
      <div class="frame" style="padding: 24px"><svg role="img" aria-label="Ba lớp của sản phẩm: lớp định hình ở trên, chữ decal ở giữa, giấy nền ở dưới" viewBox="0 0 520 340" style="width: 100%; height: auto; display: block">
            <rect x="40" y="40" width="440" height="56" rx="8" fill="#DDE5E4" stroke="#111" stroke-width="2"></rect>
            <text x="260" y="75" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="700" font-size="18" fill="#111">Lớp định hình (giấy chuyển)</text>
            <rect x="40" y="120" width="440" height="56" rx="8" fill="#FFC400" stroke="#111" stroke-width="2"></rect>
            <text x="260" y="155" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="700" font-size="18" fill="#111">Chữ decal đã cắt</text>
            <rect x="40" y="200" width="440" height="56" rx="8" fill="#FFFFFF" stroke="#111" stroke-width="2"></rect>
            <text x="260" y="235" text-anchor="middle" font-family="Be Vietnam Pro, sans-serif" font-weight="700" font-size="18" fill="#111">Giấy nền (bóc ra khi dán)</text>
            <path d="M260 280 L260 322" stroke="#111" stroke-width="3" stroke-linecap="round"></path>
            <path d="M248 310 L260 324 L272 310" stroke="#111" stroke-width="3" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
          </svg></div>
      <div class="stack stack-5">
        <span class="eyebrow">Cách hoạt động</span>
        <h2 class="h2">Dán trong ba động tác</h2>
        <div class="num-list">
          <div><span class="n">1</span><div><b>Bóc giấy nền.</b> Chữ vẫn dính trên lớp định hình, giữ đúng vị trí.</div></div>
          <div><span class="n">2</span><div><b>Đặt lên bề mặt và miết.</b> Miết từ giữa ra ngoài để chữ bám chắc.</div></div>
          <div><span class="n">3</span><div><b>Bóc lớp định hình.</b> Chữ ở lại trên bề mặt, thẳng hàng như đã thiết kế.</div></div>
        </div>
      </div>
    </div>
  </section>

  <!-- Video hướng dẫn -->
  <section class="section section--white">
    <div class="wrap stack stack-6" style="gap: 36px">
      <div class="sec-head" style="margin-bottom: 0"><div><span class="eyebrow">Video hướng dẫn</span><h2 class="h2">Xem là dán được</h2></div></div>
      <div style="display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 1fr); gap: 32px; align-items: start" class="video-grid">
        <div class="stack stack-4">
          <div class="video-box">
            <svg role="img" aria-label="Nút phát video" width="72" height="72" viewBox="0 0 72 72"><circle cx="36" cy="36" r="34" fill="#FFC400"></circle><path d="M29 22 L52 36 L29 50 Z" fill="#18150F"></path></svg>
            <div style="font-size: 13px; font-weight: 600">[CHÈN VIDEO: <span id="v-title-ph">{active.title}</span>]</div>
          </div>
          <h3 id="v-title" class="h3" style="font-size: 22px">{active.title}</h3>
          <p id="v-desc" class="muted" style="font-size: 16px; line-height: 1.8">{active.desc}</p>
        </div>
        <div class="stack stack-3">
          {videos.map((v) => (<>
            <button type="button" class={v.cls} data-i={v.i}>
              <span>{v.title}</span>
              <span>{v.length}</span>
            </button>
          </>))}
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="cta-band">
        <div class="copy"><h2>Sẵn sàng thử chưa?</h2><p>Chọn mẫu có sẵn hoặc gửi file để bên mình cắt theo yêu cầu.</p></div>
        <div class="row">
          <a class="btn btn--primary" href="/san-pham/">Xem sản phẩm mẫu</a>
          <a class="btn btn--ghost" href="/lien-he/">Gửi yêu cầu tư vấn</a>
        </div>
      </div>
    </div>
  </section>

</Layout>
<script define:vars={{ list }}>
  const btns = Array.from(document.querySelectorAll('.vbtn'));
  btns.forEach((b) => b.addEventListener('click', () => {
    const v = list[Number(b.dataset.i)];
    btns.forEach((x) => x.classList.toggle('on', x === b));
    document.getElementById('v-title-ph').textContent = v.title;
    document.getElementById('v-title').textContent = v.title;
    document.getElementById('v-desc').textContent = v.desc;
  }));
</script>