---
import Layout from '../../layouts/Layout.astro';
import Scene from '../../components/Scene.astro';
import services from '../../data/services.json';
export function getStaticPaths() { return services.map((service) => ({ params: { slug: service.slug }, props: { service } })); }
const { service } = Astro.props;
const others = services.filter((s) => s.slug !== service.slug);
const process = [
  'Gửi file thiết kế hoặc mô tả yêu cầu.',
  'Kiểm tra file, tư vấn chất liệu và báo giá.',
  'Xác nhận phương án cắt và sản xuất.',
  'Nhận tại TP.HCM hoặc giao toàn quốc.'
];
---
<Layout title={`${service.name} tại TP.HCM | CatDecal.vn`} description={service.short} active="service">
  <header class="page-hero page-hero--split">
    <div class="wrap">
      <div class="copy">
        <nav class="crumb" aria-label="Đường dẫn"><a href="/">Trang chủ</a><span aria-hidden="true">/</span><a href="/dich-vu/">Dịch vụ</a><span aria-hidden="true">/</span><span>{service.name}</span></nav>
        <span class="eyebrow">Gia công theo yêu cầu · TP.HCM</span>
        <h1 style="max-width: 16ch">{service.name}</h1>
        <p class="lead">{service.short} Gửi file hoặc mô tả mong muốn để được kiểm tra và xác nhận phương án gia công phù hợp.</p>
        <div class="row">
          <a class="btn btn--primary" href="/dich-vu/#yeu-cau">Gửi file nhận báo giá <span aria-hidden="true">↗</span></a>
          <a class="btn btn--ghost" href="tel:0866077040">Gọi 0866 077 040</a>
        </div>
      </div>
      <div class="frame"><Scene scene={service.scene} ink={service.ink} label={service.sample} /></div>
    </div>
  </header>

  <section class="section">
    <div class="wrap">
      <div class="sec-head"><div><span class="eyebrow">Hình mẫu ứng dụng</span><h2 class="h2">Dịch vụ này phù hợp để làm gì?</h2></div></div>
      <div class="grid grid--3">
        {service.examples.map((e, i) => (
          <div class="card" style="padding: 28px; display: flex; flex-direction: column; gap: 14px">
            <span class="num-badge" style="position: static; align-self: flex-start">0{i + 1}</span>
            <h3 class="h3">{e}</h3>
            <p class="muted" style="font-size: 15px; line-height: 1.75">Mẫu ứng dụng tham khảo; có thể điều chỉnh theo file và kích thước thực tế của khách.</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="section section--ink">
    <div class="wrap split">
      <div class="stack stack-4">
        <span class="eyebrow">Quy trình</span>
        <h2 class="h2">Từ yêu cầu đến thành phẩm</h2>
        <p class="lead">Đội ngũ xác nhận nội dung, vật liệu và chi phí trước khi tiến hành sản xuất.</p>
      </div>
      <ol class="num-list" style="list-style: none; padding: 0; margin: 0">
        {process.map((t, i) => (<li style="display: flex; gap: 16px; align-items: flex-start; font-size: 16.5px; font-weight: 700; color: #fff; line-height: 1.6"><span class="n" style="flex: none; width: 38px; height: 38px; border-radius: 12px; background: var(--yellow); color: var(--ink); display: grid; place-items: center; font-weight: 900; transform: rotate(-3deg)">{i + 1}</span><span style="padding-top: 6px">{t}</span></li>))}
      </ol>
    </div>
  </section>

  <section class="section">
    <div class="wrap stack stack-6" style="gap: 56px">
      <div class="cta-band">
        <div class="copy"><h2>Cần cắt decal theo kích thước riêng?</h2><p>Gửi file để nhận tư vấn và báo giá phù hợp với yêu cầu của bạn.</p></div>
        <a class="btn btn--primary" href="/dich-vu/#yeu-cau">Gửi yêu cầu báo giá <span aria-hidden="true">↗</span></a>
      </div>
      <div class="stack stack-4">
        <span class="eyebrow">Dịch vụ khác</span>
        <div class="tag-links">{others.map((s) => (<a href={'/dich-vu/' + s.slug + '/'}>{s.name}</a>))}</div>
      </div>
    </div>
  </section>
</Layout>
